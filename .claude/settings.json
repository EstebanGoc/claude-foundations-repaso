{
  "permissions": {
    "allow": [
      "Bash(python init.py:*)",
      "Bash(python3 init.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge --continue)",
      "Bash(git rebase --continue)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Write(.claude/workspace/**)",
      "Edit(.claude/workspace/**)",
      "Write(.claude/agent-memory/**)",
      "Edit(.claude/agent-memory/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'for c in python3 python py; do if command -v \"$c\" >/dev/null 2>&1 && \"$c\" -c \"\" >/dev/null 2>&1; then exec \"$c\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.py\"; fi; done; exit 0'"
          }
        ]
      }
    ]
  }
}
